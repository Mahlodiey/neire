generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Authentication-ready user model. Passwords should be stored as hashes only.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  materials       StudyMaterial[]
  learningPaths   LearningPath[]
  tutorSessions   TutorSession[]
  attempts        AnswerAttempt[]
  mastery         TopicMastery[]
  reviewSchedules ReviewSchedule[]

  @@map("users")
}

model StudyMaterial {
  id          String         @id @default(cuid())
  userId      String
  title       String
  description String?
  fileName    String?
  fileType    String
  fileSize    Int?
  storageKey  String?
  sourceText  String?
  status      MaterialStatus @default(UPLOADED)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks        DocumentChunk[]
  topics        Topic[]
  learningPaths LearningPath[]

  @@index([userId, createdAt])
  @@map("study_materials")
}

enum MaterialStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

model DocumentChunk {
  id         String   @id @default(cuid())
  materialId String
  chunkIndex Int
  content    String
  pageNumber Int?
  metadata   Json?
  createdAt  DateTime @default(now())

  material StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, chunkIndex])
  @@index([materialId])
  @@map("document_chunks")
}

model Topic {
  id          String   @id @default(cuid())
  materialId  String
  parentId    String?
  title       String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  material       StudyMaterial    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  parent         Topic?           @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Topic[]          @relation("TopicHierarchy")
  concepts       Concept[]
  pathItems      LearningPathItem[]
  questions      Question[]
  mastery        TopicMastery[]
  reviewSchedules ReviewSchedule[]

  @@index([materialId, position])
  @@index([parentId])
  @@map("topics")
}

model Concept {
  id          String   @id @default(cuid())
  topicId     String
  title       String
  explanation String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  topic     Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([topicId, position])
  @@map("concepts")
}

model LearningPath {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  title      String
  status     PathStatus @default(ACTIVE)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  material StudyMaterial     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  items    LearningPathItem[]

  @@index([userId, status])
  @@map("learning_paths")
}

enum PathStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model LearningPathItem {
  id       String     @id @default(cuid())
  pathId   String
  topicId  String
  position Int
  activity ActivityType
  status   ItemStatus @default(NOT_STARTED)
  metadata Json?
  startedAt DateTime?
  completedAt DateTime?

  path  LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  topic Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([pathId, position])
  @@index([pathId, status])
  @@map("learning_path_items")
}

enum ActivityType {
  EXPLANATION
  EXAMPLE
  PRACTICE
  RECALL
  REVIEW
  APPLICATION
}

enum ItemStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model TutorSession {
  id        String   @id @default(cuid())
  userId    String
  topicId   String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic    Topic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  messages TutorMessage[]

  @@index([userId, updatedAt])
  @@map("tutor_sessions")
}

model TutorMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      MessageRole
  content   String
  mode      TeachingMode @default(TEXT)
  metadata  Json?
  createdAt DateTime    @default(now())

  session TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("tutor_messages")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum TeachingMode {
  TEXT
  VOICE
  VISUAL
  EXAMPLE
  STORY
  CONVERSATION
}

model Question {
  id            String       @id @default(cuid())
  topicId       String
  conceptId     String?
  type          QuestionType
  prompt        String
  answer        String
  explanation   String?
  options       Json?
  difficulty    Int          @default(1)
  source        QuestionSource @default(AI_GENERATED)
  createdAt     DateTime     @default(now())

  topic    Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  concept  Concept?        @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  attempts AnswerAttempt[]

  @@index([topicId, difficulty])
  @@map("questions")
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  OPEN_ENDED
}

enum QuestionSource {
  AI_GENERATED
  MANUAL
}

model AnswerAttempt {
  id           String   @id @default(cuid())
  userId       String
  questionId   String
  answer       String
  isCorrect    Boolean
  score        Float?
  confidence   Int?
  feedback     String?
  responseTime Int?
  createdAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([questionId, createdAt])
  @@map("answer_attempts")
}

model TopicMastery {
  id             String   @id @default(cuid())
  userId         String
  topicId        String
  mastery        Float    @default(0)
  confidence     Float    @default(0)
  retention      Float    @default(0)
  attemptsCount  Int      @default(0)
  lastPracticedAt DateTime?
  updatedAt      DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, mastery])
  @@map("topic_mastery")
}

model ReviewSchedule {
  id           String   @id @default(cuid())
  userId       String
  topicId      String
  dueAt        DateTime
  intervalDays Int      @default(1)
  easeFactor   Float    @default(2.5)
  repetitions  Int      @default(0)
  lastReviewedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, dueAt])
  @@map("review_schedules")
}
